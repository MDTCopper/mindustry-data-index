{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/repo-created.json",
  "title": "repo-created",
  "description": "仓库 created_at 永久缓存 state/repo-created.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "required": [
    "formatVersion",
    "updatedAt",
    "repos"
  ],
  "additionalProperties": true
}
