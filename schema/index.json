{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/index.json",
  "title": "index",
  "description": "官方模组索引 index.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 3
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "source": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/index-source.json",
      "title": "index-source",
      "description": "官方来源",
      "type": "object",
      "properties": {
        "modsUrl": {
          "type": "string"
        },
        "modCount": {
          "type": "integer"
        }
      },
      "required": [
        "modsUrl",
        "modCount"
      ],
      "additionalProperties": true
    },
    "mods": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/index-mod.json",
        "title": "index-mod",
        "description": "官方模组条目",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namePlain": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "authorPlain": {
            "type": "string"
          },
          "descriptionPlain": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "minGameVersion": {
            "type": "string"
          },
          "stars": {
            "type": "integer"
          },
          "hasIcon": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "iconHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "releasesPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseCount": {
            "type": "integer"
          },
          "totalDownloads": {
            "type": "integer"
          },
          "allAssetsDownloads": {
            "type": "integer"
          },
          "releaseDataUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "modType": {
            "enum": [
              "java",
              "js",
              "json"
            ]
          },
          "gameVersionRanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "releaseUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "commitUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "tagCount": {
            "type": "integer",
            "minimum": 0
          },
          "heat": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "downloadsScore": {
                "type": "number"
              },
              "starsScore": {
                "type": "number"
              },
              "updateScore": {
                "type": "number"
              },
              "recommendVisible": {
                "type": "boolean"
              }
            },
            "required": [
              "score",
              "rank",
              "downloadsScore",
              "starsScore",
              "updateScore",
              "recommendVisible"
            ],
            "additionalProperties": false
          },
          "ranks": {
            "type": "object",
            "required": [
              "heat",
              "updated",
              "downloads",
              "stars",
              "newest"
            ],
            "properties": {
              "heat": {
                "type": "integer",
                "minimum": 1
              },
              "updated": {
                "type": "integer",
                "minimum": 1
              },
              "downloads": {
                "type": "integer",
                "minimum": 1
              },
              "stars": {
                "type": "integer",
                "minimum": 1
              },
              "newest": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "pages": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "page",
                "count",
                "gameVersionRanges",
                "path"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "gameVersionRanges": {
                  "type": "array"
                },
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [
          "repo",
          "name",
          "namePlain",
          "author",
          "authorPlain",
          "descriptionPlain",
          "modType",
          "gameVersionRanges",
          "stars",
          "releasesPath",
          "releaseCount",
          "releaseUpdatedAt",
          "commitUpdatedAt",
          "totalDownloads",
          "allAssetsDownloads",
          "heat",
          "ranks"
        ],
        "additionalProperties": true
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/skipped.json",
        "title": "skipped",
        "description": "抓取失败的仓库",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "reason"
        ],
        "additionalProperties": true
      }
    },
    "sortOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "defaultSort": {
      "type": "string"
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "source",
    "mods",
    "skipped",
    "sortOptions",
    "defaultSort"
  ],
  "additionalProperties": true,
  "formatVersion": 3
}
