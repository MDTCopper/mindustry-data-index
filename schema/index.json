{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/index.json",
  "title": "index",
  "description": "官方模组索引 index.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "source": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/index-source.json",
      "title": "index-source",
      "description": "官方来源",
      "type": "object",
      "properties": {
        "modsUrl": {
          "type": "string"
        },
        "modCount": {
          "type": "integer"
        }
      },
      "required": [
        "modsUrl",
        "modCount"
      ],
      "additionalProperties": true
    },
    "mods": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/index-mod.json",
        "title": "index-mod",
        "description": "官方模组条目",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "internalName": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "namePlain": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "authorPlain": {
            "type": "string"
          },
          "descriptionPlain": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "minGameVersion": {
            "type": "string"
          },
          "lastUpdated": {
            "type": [
              "string",
              "null"
            ]
          },
          "stars": {
            "type": "integer"
          },
          "hasIcon": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "hasScripts": {
            "type": "boolean"
          },
          "hasJava": {
            "type": "boolean"
          },
          "iosCompatible": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "legacyCompatible": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "iconHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "releasesPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseCount": {
            "type": "integer"
          },
          "tagCount": {
            "type": "integer"
          },
          "removedCount": {
            "type": "integer"
          },
          "totalDownloads": {
            "type": "integer"
          },
          "allAssetsDownloads": {
            "type": "integer"
          },
          "latestDownloads": {
            "type": "integer"
          },
          "latestSizeBytes": {
            "type": [
              "number",
              "null"
            ]
          },
          "totalSizeBytes": {
            "type": [
              "number",
              "null"
            ]
          },
          "latestRelease": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/latest-release.json",
                "title": "latest-release",
                "description": "最新未删除 Release 摘要",
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "prerelease": {
                    "type": "boolean"
                  },
                  "publishedAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "downloads": {
                    "type": "integer"
                  },
                  "sizeBytes": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "tag",
                  "name",
                  "prerelease",
                  "publishedAt",
                  "downloads",
                  "sizeBytes"
                ],
                "additionalProperties": true
              }
            ]
          },
          "latestCompatible": {
            "type": [
              "string",
              "null"
            ]
          },
          "compatRanges": {
            "type": "integer"
          },
          "releaseDataUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "heat": {
            "type": "object",
            "description": "精简热度（官方+社区全局排名）",
            "properties": {
              "score": {
                "type": "number"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "downloadsScore": {
                "type": "number"
              },
              "starsScore": {
                "type": "number"
              },
              "updateScore": {
                "type": "number"
              },
              "recommendVisible": {
                "type": "boolean"
              }
            },
            "required": [
              "score",
              "rank",
              "downloadsScore",
              "starsScore",
              "updateScore",
              "recommendVisible"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "repo",
          "internalName",
          "name",
          "namePlain",
          "author",
          "authorPlain",
          "descriptionPlain",
          "version",
          "minGameVersion",
          "lastUpdated",
          "stars",
          "hasIcon",
          "hasScripts",
          "hasJava",
          "iosCompatible",
          "legacyCompatible",
          "iconUrl",
          "iconHash",
          "releasesPath",
          "releaseCount",
          "tagCount",
          "removedCount",
          "totalDownloads",
          "allAssetsDownloads",
          "latestDownloads",
          "latestSizeBytes",
          "totalSizeBytes",
          "latestRelease",
          "latestCompatible",
          "compatRanges",
          "releaseDataUpdatedAt",
          "heat"
        ],
        "additionalProperties": true
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/skipped.json",
        "title": "skipped",
        "description": "抓取失败的仓库",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "reason"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "source",
    "mods",
    "skipped"
  ],
  "additionalProperties": true
}
