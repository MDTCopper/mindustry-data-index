{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/releases.json",
  "title": "releases",
  "description": "per-mod 文件（官方与社区同构，schemaVersion=3）",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 3
    },
    "repo": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "meta": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/file-meta.json",
          "title": "file-meta",
          "description": "最新 tag 的完整 mod 元数据",
          "type": "object",
          "properties": {
            "dependencies": {
              "type": "object"
            },
            "hidden": {
              "type": "boolean"
            },
            "legacyCompatible": {
              "type": "boolean"
            },
            "main": {
              "type": [
                "string",
                "null"
              ]
            },
            "hasScripts": {
              "type": "boolean"
            },
            "hasJava": {
              "type": "boolean"
            }
          },
          "required": [
            "dependencies",
            "hidden",
            "legacyCompatible",
            "main",
            "hasScripts",
            "hasJava"
          ],
          "additionalProperties": true
        }
      ]
    },
    "modType": {
      "enum": [
        "java",
        "js",
        "json"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "release",
              "tag",
              "source"
            ]
          },
          "modVersion": {
            "type": "string"
          },
          "minGameVersion": {
            "type": "string"
          },
          "gameVersionRanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "releasedAt": {
            "type": "string"
          },
          "committedAt": {
            "type": "string"
          },
          "downloadUrl": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "downloadCount": {
            "type": "integer",
            "minimum": 0
          },
          "prerelease": {
            "type": "boolean"
          },
          "removed": {
            "type": "boolean"
          },
          "removedAt": {
            "type": "string"
          }
        },
        "required": [
          "tag",
          "kind",
          "minGameVersion",
          "gameVersionRanges",
          "downloadUrl"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "repo",
    "generatedAt",
    "modType",
    "versions"
  ],
  "additionalProperties": true
}
