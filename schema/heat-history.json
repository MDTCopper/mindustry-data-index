{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/heat-history.json",
  "title": "heat-history",
  "description": "热度历史快照 heat/history/{daily,weekly,monthly}/YYYY-*.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "mods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stars": {
            "type": "number"
          },
          "totalDownloads": {
            "type": "number"
          }
        },
        "required": ["stars", "totalDownloads"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "mods"
  ],
  "additionalProperties": true
}
