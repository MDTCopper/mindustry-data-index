{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/summary.json",
  "title": "summary",
  "description": "summary.json（官方与社区同构）",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "totals": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/summary-totals.json",
      "title": "summary-totals",
      "description": "全局合计",
      "type": "object",
      "properties": {
        "mods": {
          "type": "integer",
          "minimum": 0
        },
        "releases": {
          "type": "integer",
          "minimum": 0
        },
        "downloads": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mods",
        "releases",
        "downloads"
      ],
      "additionalProperties": true
    },
    "mods": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/summary-row.json",
        "title": "summary-row",
        "description": "总表一行（列顺序即 CSV 列顺序）",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namePlain": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "modType": {
            "enum": [
              "java",
              "js",
              "json"
            ]
          },
          "releaseCount": {
            "type": "integer",
            "minimum": 0
          },
          "tagCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalDownloads": {
            "type": "integer",
            "minimum": 0
          },
          "allAssetsDownloads": {
            "type": "integer",
            "minimum": 0
          },
          "minGameVersion": {
            "type": "string"
          },
          "gameVersionRanges": {
            "type": "string"
          },
          "releaseUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "commitUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": "number"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "recommendVisible": {
            "type": "boolean"
          },
          "releasesPath": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "name",
          "namePlain",
          "author",
          "stars",
          "modType",
          "releaseCount",
          "totalDownloads",
          "allAssetsDownloads",
          "minGameVersion",
          "gameVersionRanges",
          "releaseUpdatedAt",
          "commitUpdatedAt",
          "iconUrl",
          "releasesPath",
          "score",
          "rank",
          "recommendVisible"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "totals",
    "mods"
  ],
  "additionalProperties": true
}
