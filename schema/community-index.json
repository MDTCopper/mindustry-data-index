{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/community-index.json",
  "title": "community-index",
  "description": "社区模组索引 community/index.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 3
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "source": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/community-source.json",
      "title": "community-source",
      "description": "topic 发现来源",
      "type": "object",
      "properties": {
        "source": {
          "const": "topic"
        },
        "query": {
          "type": "string"
        },
        "officialCount": {
          "type": "integer"
        }
      },
      "required": [
        "source",
        "query"
      ],
      "additionalProperties": true
    },
    "mods": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/community-mod.json",
        "title": "community-mod",
        "description": "社区模组条目",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namePlain": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "authorPlain": {
            "type": "string"
          },
          "descriptionPlain": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "minGameVersion": {
            "type": "string"
          },
          "stars": {
            "type": "integer"
          },
          "hasIcon": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "iconHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "releasesPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseCount": {
            "type": "integer"
          },
          "totalDownloads": {
            "type": "integer"
          },
          "allAssetsDownloads": {
            "type": "integer"
          },
          "releaseDataUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "modType": {
            "enum": [
              "java",
              "js",
              "json"
            ]
          },
          "gameVersionRanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "releaseUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "commitUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "tagCount": {
            "type": "integer",
            "minimum": 0
          },
          "heat": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "downloadsScore": {
                "type": "number"
              },
              "starsScore": {
                "type": "number"
              },
              "updateScore": {
                "type": "number"
              },
              "recommendVisible": {
                "type": "boolean"
              }
            },
            "required": [
              "score",
              "rank",
              "downloadsScore",
              "starsScore",
              "updateScore",
              "recommendVisible"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "repo",
          "name",
          "namePlain",
          "author",
          "authorPlain",
          "descriptionPlain",
          "modType",
          "gameVersionRanges",
          "stars",
          "releasesPath",
          "releaseCount",
          "releaseUpdatedAt",
          "commitUpdatedAt",
          "totalDownloads",
          "allAssetsDownloads",
          "heat"
        ],
        "additionalProperties": true
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/skipped.json",
        "title": "skipped",
        "description": "抓取失败的仓库",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "reason"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "source",
    "mods",
    "skipped"
  ],
  "additionalProperties": true,
  "formatVersion": 3
}
