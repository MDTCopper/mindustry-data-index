{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDTCopper/mindustry-data-index/schema/heat-index.json",
  "title": "heat-index",
  "description": "热度表 heat/index.json（官方+社区全量，v2 占比归一 + 活动递减收益）",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC ISO 8601 时间"
    },
    "source": {
      "type": "object",
      "properties": {
        "official": {
          "type": "integer"
        },
        "community": {
          "type": "integer"
        }
      },
      "required": [
        "official",
        "community"
      ],
      "additionalProperties": false
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "namePlain": {
            "type": "string"
          },
          "source": {
            "enum": [
              "official",
              "community"
            ]
          },
          "totalDownloads": {
            "type": "number"
          },
          "totalStars": {
            "type": "number"
          },
          "stockShare": {
            "type": "object",
            "properties": {
              "downloads": {
                "type": "number"
              },
              "stars": {
                "type": "number"
              }
            },
            "required": [
              "downloads",
              "stars"
            ],
            "additionalProperties": false
          },
          "stockMag": {
            "type": "object",
            "properties": {
              "downloads": {
                "type": "number"
              },
              "stars": {
                "type": "number"
              }
            },
            "required": [
              "downloads",
              "stars"
            ],
            "additionalProperties": false
          },
          "stockScore": {
            "type": "object",
            "properties": {
              "downloads": {
                "type": "number"
              },
              "stars": {
                "type": "number"
              }
            },
            "required": [
              "downloads",
              "stars"
            ],
            "additionalProperties": false
          },
          "downloadChanges": {
            "type": "object",
            "description": "各窗口下载量变化（1d/7d/30d/180d）",
            "properties": {
              "1": {
                "type": "number"
              },
              "7": {
                "type": "number"
              },
              "30": {
                "type": "number"
              },
              "180": {
                "type": "number"
              }
            },
            "required": [
              "1",
              "7",
              "30",
              "180"
            ],
            "additionalProperties": false
          },
          "starChanges": {
            "type": "object",
            "description": "各窗口星标变化（1d/7d/30d/180d）",
            "properties": {
              "1": {
                "type": "number"
              },
              "7": {
                "type": "number"
              },
              "30": {
                "type": "number"
              },
              "180": {
                "type": "number"
              }
            },
            "required": [
              "1",
              "7",
              "30",
              "180"
            ],
            "additionalProperties": false
          },
          "releaseUpdates": {
            "type": "object",
            "description": "各窗口 release 更新数（7/30/90/180d）",
            "properties": {
              "7": {
                "type": "number"
              },
              "30": {
                "type": "number"
              },
              "90": {
                "type": "number"
              },
              "180": {
                "type": "number"
              }
            },
            "required": [
              "7",
              "30",
              "90",
              "180"
            ],
            "additionalProperties": false
          },
          "commits": {
            "type": "object",
            "description": "各窗口提交数（7/30/90/180d，participation 周粒度近似）",
            "properties": {
              "7": {
                "type": "number"
              },
              "30": {
                "type": "number"
              },
              "90": {
                "type": "number"
              },
              "180": {
                "type": "number"
              }
            },
            "required": [
              "7",
              "30",
              "90",
              "180"
            ],
            "additionalProperties": false
          },
          "releaseActivityRaw": {
            "type": "number",
            "minimum": 0
          },
          "commitActivityRaw": {
            "type": "number",
            "minimum": 0
          },
          "releaseActivity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "commitActivity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "downloadsScore": {
            "type": "number"
          },
          "starsScore": {
            "type": "number"
          },
          "updateScore": {
            "type": "number"
          },
          "newModMultiplier": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.325
          },
          "penalty": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score": {
            "type": "number"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "downloadsMissing": {
            "type": "boolean"
          },
          "effectiveWeights": {
            "type": "object",
            "properties": {
              "downloads": {
                "type": "number"
              },
              "stars": {
                "type": "number"
              },
              "update": {
                "type": "number"
              }
            },
            "required": [
              "downloads",
              "stars",
              "update"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "repo",
          "namePlain",
          "source",
          "totalDownloads",
          "totalStars",
          "stockShare",
          "stockMag",
          "stockScore",
          "downloadChanges",
          "starChanges",
          "releaseUpdates",
          "commits",
          "releaseActivityRaw",
          "commitActivityRaw",
          "releaseActivity",
          "commitActivity",
          "downloadsScore",
          "starsScore",
          "updateScore",
          "newModMultiplier",
          "penalty",
          "score",
          "rank",
          "downloadsMissing",
          "effectiveWeights"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "source",
    "mods"
  ],
  "additionalProperties": true
}
